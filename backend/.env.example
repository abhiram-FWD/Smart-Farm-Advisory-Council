# Backend secrets and database configuration. Keep real values in an ignored .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MONGODB_URI=
MONGODB_DB_NAME=smart_farm_db
FARM_TOKEN_PEPPER=
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integration tests use this isolated database only.
AGRIVISION_TEST_MONGODB_URI=
AGRIVISION_TEST_DB_NAME=agrivision_test_db
